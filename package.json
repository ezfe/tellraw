{
  "name": "tellraw",
  "description": "Minecraft Formatted JSON Creator",
  "repository": "https://github.com/ezfe/tellraw",
  "author": "ezfe",
  "license": "MIT",
  "version": "8.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "vite package",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^1.3.0",
    "@fortawesome/free-brands-svg-icons": "^5.5.0",
    "@fortawesome/free-solid-svg-icons": "^5.5.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@sveltestrap/sveltestrap": "^7.1.0",
    "bootstrap": "^5.3.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-dnd-action": "^0.9.70",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.0"
  },
  "type": "module",
  "allowScripts": {
    "@fortawesome/fontawesome-common-types": false,
    "@fortawesome/fontawesome-svg-core": false,
    "@fortawesome/free-brands-svg-icons": false,
    "@fortawesome/free-solid-svg-icons": false,
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}